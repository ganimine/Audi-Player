        android:pathData="M37,42 C41,32 47,28.5 54,28.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="37"
                android:startY="42"
                android:endX="54"
                android:endY="28.5"
                android:type="linear">
                <item android:offset="0.0" android:color="#34A853" />
                <item android:offset="1.0" android:color="#4285F4" />
            </gradient>
        </aapt:attr>
    </path>
    <path
