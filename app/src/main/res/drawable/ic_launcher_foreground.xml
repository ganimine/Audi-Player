    <path
        android:fillColor="#4285F4"
        android:pathData="M65.5,49.5 h1.5 v9 h-1.5 z" />
    <path
        android:fillColor="#EA4335"
        android:pathData="M68,51.5 h1.5 v5 h-1.5 z" />

